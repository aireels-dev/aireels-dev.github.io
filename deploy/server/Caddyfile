{
	admin off
	persist_config off
	auto_https off
	servers {
		protocols h1
	}
}

:8080 {
	root * /srv/releases/current
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		@chinese path /zh /zh/*
		handle @chinese {
			rewrite * /zh/404/index.html
			file_server
		}
		handle {
			rewrite * /en/404/index.html
			file_server
		}
	}
}
