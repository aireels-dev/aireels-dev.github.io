---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import HorizonScenarios from '../components/HorizonScenarios.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import { siteConfig } from '../config';
import { servicePresentation, workingProcess } from '../data/site-content';
---
<Layout title="服务介绍" description="探索灵映科技的 AI 智能化集成、内容创作助手与技术咨询服务。从业务场景到系统接入，让 AI 真正进入日常工作。">
  <PageIntro label="服务介绍" eyebrow="OUR CAPABILITIES / 服务能力" title="把前沿技术，" emphasis="变成日常优势。" description="从一次模型接入，到一套业务工具。围绕你的实际问题，找到恰到好处的 AI 应用方式。">
    <a class="secondary-action" href="#service-details">探索三项核心服务 <span aria-hidden="true">↓</span></a>
  </PageIntro>
  <nav class="service-directory" aria-label="服务目录">
    {servicePresentation.map((service, i) => <a href={`#${service.id}`}><span class="mono">0{i + 1} / {service.english}</span><span>{siteConfig.features[i].title}</span><b aria-hidden="true">↘</b></a>)}
  </nav>
  <div id="service-details" class="service-details section-space">
    {servicePresentation.map((service, i) => <section class="service-detail" id={service.id} aria-labelledby={`title-${service.id}`}>
      <div class="service-detail-heading" data-reveal>
        <p class="eyebrow">0{i + 1} / {service.english}</p><h2 id={`title-${service.id}`}>{service.title.split('，')[0]}，<br /><em>{service.title.split('，')[1]}</em></h2>
        <p>{service.description}</p>
        <div class={`service-drawing drawing-${i}`} aria-hidden="true">{Array.from({ length: i === 1 ? 9 : 5 }, (_, n) => <span style={`--n:${n}`}></span>)}</div>
      </div>
      <div class="service-detail-content" data-reveal>
        <p class="service-detail-category">{siteConfig.features[i].title}</p>
        <p class="service-detail-lead">{siteConfig.features[i].description}。</p>
        <div class="service-scope">{siteConfig.features[i].details.map((detail, index) => {
          const [title, description] = detail.split('：');
          return <article><span class="mono">0{index + 1}</span><div><h3>{title}</h3><p>{description}</p></div></article>;
        })}</div>
        <div class="service-fit"><span class="eyebrow">IS THIS FOR YOU? / 适用需求</span><p>{service.audience}</p></div>
        <div class="service-outcomes" aria-label="可构建的应用方向">{service.outcome.map(outcome => <span>{outcome}</span>)}</div>
        <a class="text-link" href="/contact/">咨询这项服务 <span aria-hidden="true">↗</span></a>
      </div>
    </section>)}
  </div>
  <HorizonScenarios />
  <section class="process-section section-space" aria-labelledby="process-title">
    <div class="section-heading" data-reveal><div><p class="eyebrow">FROM FIRST TALK TO EVERYDAY USE</p><h2 id="process-title">一步一步，<br /><span>让智能落地。</span></h2></div><p>先把需求说清楚，<br />再让每一步都有明确的方向。</p></div>
    <div class="process-grid">{workingProcess.map(step => <article data-reveal><span class="process-number">{step.number}</span><p class="eyebrow">{step.english}</p><h3>{step.title}</h3><p>{step.description}</p><small>{step.scope}</small></article>)}</div>
    <p class="process-note">具体服务范围、实施计划与费用，在了解业务需求后共同确认。</p>
  </section>
  <FaqSection />
  <ContactCTA />
</Layout>
