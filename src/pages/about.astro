---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactCTA from '../components/ContactCTA.astro';
const principles = [
  { number: '01', title: '技术，应该更容易。', description: '不把复杂性留给使用者。通过应用指导与技术支持，让没有 AI 技术背景的团队也能迈出第一步。', label: 'ACCESSIBLE BY DESIGN' },
  { number: '02', title: '投入，应该有方向。', description: '从业务需求与预算出发选择模型和方案，优先解决具体问题，让有限的资源用在值得的地方。', label: 'PURPOSE BEFORE SCALE' },
  { number: '03', title: '工具，应该用得起来。', description: '让 AI 融入已有系统和工作习惯，关注部署之后的使用体验，通过持续优化让工具更贴近业务。', label: 'BUILT FOR REAL WORK' },
];
const audiences = [
  ['个人创业者', '把时间还给创造。', '为自由职业者与个人服务提供商，构建内容创作与日常工作中的 AI 工具。'],
  ['小型企业', '小团队，也能更从容。', '围绕客户咨询、内容营销与内部协作，找到适合当前阶段的智能化方案。'],
  ['传统企业', '熟悉的业务，新的能力。', '在已有系统和流程上接入 AI，让数字化升级从一个实际场景开始。'],
  ['创新团队', '让想法，更快进入应用。', '为需要接入大模型能力的团队，提供技术咨询、系统集成与部署支持。'],
];
---
<Layout title="关于我们" description="认识郑州灵映科技有限公司。我们专注 AI 技术集成与应用，为中小企业和个人创业者连接前沿技术与真实业务。">
  <PageIntro label="关于我们" eyebrow="ABOUT AIREELS / 关于灵映" title="技术向前，" emphasis="也让你向前。" description="我们是灵映科技。立足郑州，专注 AI 技术集成与应用，做你的智能化业务伙伴。">
    <a class="secondary-action" href="#who-we-are">认识我们的想法 <span aria-hidden="true">↓</span></a>
  </PageIntro>
  <section class="company-section section-space" id="who-we-are" aria-labelledby="company-title">
    <div class="company-mark" aria-hidden="true"><div class="company-mark-orbit"></div><img src="/brand/aireels-logo-master.png" width="2200" height="2200" alt="" loading="lazy" /><span>AIREELS / HUMAN × INTELLIGENCE</span></div>
    <div class="company-copy" data-reveal><p class="eyebrow">A SMALLER DISTANCE TO WHAT’S NEXT</p><h2 id="company-title">让 AI 的可能，<br /><span>离每个人更近。</span></h2><p class="company-lead">郑州灵映科技有限公司</p><p>我们专注为中小企业和个人创业者提供 AI 集成与智能化解决方案，将大语言模型、内容创作工具与现有业务系统连接。</p><p>我们相信，技术的价值体现在每一天的使用里。从一个具体问题开始，让复杂的能力成为简单、实用的工具，帮助团队把时间留给核心业务。</p><a class="text-link" href="/services/">看看我们能做什么 <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="principles-section section-space" aria-labelledby="principles-title">
    <div class="section-heading" data-reveal><div><p class="eyebrow">WHAT WE BELIEVE</p><h2 id="principles-title">好的技术，<br /><span>应该回应真实需求。</span></h2></div><p>简单、实用、成本友好。<br />这是我们做方案的出发点。</p></div>
    <div class="principles-list">{principles.map(principle => <article data-reveal><span class="principle-number">{principle.number}</span><div><p class="eyebrow">{principle.label}</p><h3>{principle.title}</h3></div><p>{principle.description}</p></article>)}</div>
  </section>
  <section class="audience-section section-space" aria-labelledby="audience-title">
    <div class="section-heading" data-reveal><div><p class="eyebrow">BUILT FOR YOU</p><h2 id="audience-title">不同的起点，<br /><span>同样值得向前。</span></h2></div><p>为有实际需求的人，<br />找到适合当下的 AI 能力。</p></div>
    <div class="audience-grid">{audiences.map((audience, i) => <article data-reveal data-spotlight><span class="mono">0{i + 1} / {audience[0]}</span><h3>{audience[1]}</h3><p>{audience[2]}</p></article>)}</div>
  </section>
  <section class="location-section section-space" aria-labelledby="location-title"><div data-reveal><p class="eyebrow">BASED IN ZHENGZHOU / 立足郑州</p><h2 id="location-title">在这里，<br />连接更多可能。</h2><p>郑州市惠济区<br />工作时间：周一至周五 9:00–18:00</p><a class="text-link" href="/contact/">与我们取得联系 <span aria-hidden="true">↗</span></a></div><div class="location-art" aria-hidden="true"><span></span><span></span><span></span><i></i><b>ZHENGZHOU<small>34° N / 113° E</small></b></div></section>
  <ContactCTA />
</Layout>
