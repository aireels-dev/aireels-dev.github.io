---
import ConceptArt from './ConceptArt.astro';
import HorizonScenarios from './HorizonScenarios.astro';
import FaqSection from './FaqSection.astro';
import ContactCTA from './ContactCTA.astro';
import { getCopy } from '../i18n/copy';
import { localeFromPath, localizedPath } from '../i18n/routing';
const locale = localeFromPath(Astro.url.pathname);
const copy = getCopy(locale);
const home = copy.home;
---
<section class="concept-hero hero-horizon" aria-labelledby="hero-title">
  <ConceptArt kind="horizon" />
  <div class="hero-copy" data-parallax="-0.08">
    <p class="eyebrow"><span class="live-dot"></span>{home.eyebrow}</p>
    <h1 id="hero-title">{home.title[0]}<br /><em>{home.title[1]}</em></h1>
    <p class="hero-description">{home.description[0]}<br />{home.description[1]}</p>
    <div class="hero-actions"><a class="primary-action" href="#capabilities" data-magnetic>{home.explore} <span aria-hidden="true">↗</span></a><a class="secondary-action" href="#contact">{home.start} <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="hero-bottom"><a href="#capabilities" class="scroll-cue"><span aria-hidden="true">↓</span>{home.scroll}</a><span class="hero-index">{home.pointer}</span><span class="hero-signature">{home.signature[0]}<br />{home.signature[1]}</span></div>
</section>
<div class="capability-strip"><span>{home.strip}</span><div><span>AI INTEGRATION</span><i>✳</i><span>CONTENT CREATION</span><i>✳</i><span>TECH CONSULTING</span></div></div>
<section class="capabilities section-space" id="capabilities" aria-labelledby="capabilities-title">
  <div class="section-heading" data-reveal><div><p class="eyebrow">01 / WHAT WE DO</p><h2 id="capabilities-title">{home.capabilities[0]}<br /><span>{home.capabilities[1]}</span></h2></div><p>{home.capabilitiesDescription[0]}<br />{home.capabilitiesDescription[1]}</p></div>
  <div class="service-grid">{copy.services.map((service, i) => <article class={`service-panel service-${i}`} data-reveal data-spotlight>
    <div class="service-top"><span class="mono">0{i + 1} / {service.english}</span><span class="service-symbol" aria-hidden="true">{['⌘', '✳', '↗'][i]}</span></div>
    <div class={`service-drawing drawing-${i}`} aria-hidden="true">{Array.from({ length: i === 1 ? 9 : 5 }, (_, n) => <span style={`--n:${n}`}></span>)}</div>
    <p class="service-category">{service.category}</p><h3>{service.title.join(locale === 'en' ? ' ' : '')}</h3><p class="service-description">{service.description}</p>
    <details><summary>{copy.ui.serviceDetails} <span aria-hidden="true">+</span></summary><ul>{service.details.map(detail => <li>{detail.title} — {detail.description}</li>)}</ul></details><a class="text-link" href={localizedPath(`/services/#${service.id}`, locale)}>{copy.ui.serviceMore} <span aria-hidden="true">↗</span></a>
  </article>)}</div>
</section>
<HorizonScenarios />
<section class="story-section" id="approach" aria-labelledby="approach-title">
  <div class="story-sticky"><p class="eyebrow">02 / HOW WE BUILD</p><h2 id="approach-title">{home.approach[0]}<br />{home.approach[1]}</h2><p>{home.approachDescription[0]}<br />{home.approachDescription[1]}</p><div class="story-orbits" data-parallax="0.06" aria-hidden="true"><span></span><span></span><span></span><b>AI</b></div></div>
  <div class="story-steps">{copy.process.map(step => <article class="story-step" data-reveal><span class="step-number">{step.number}</span><p class="eyebrow">{step.english}</p><h3>{step.title}</h3><p>{step.description}</p><small>{step.scope}</small></article>)}</div>
</section>
<section class="about-section section-space" id="about" aria-labelledby="about-title">
  <p class="eyebrow" data-reveal>03 / THE PEOPLE BEHIND THE POSSIBILITY</p>
  <div class="about-composition"><h2 id="about-title" data-reveal>{home.about[0]}<br /><span>{home.about[1]}</span></h2><div data-reveal><p class="about-lead">{home.aboutLead[0]}<br />{home.aboutLead[1]}</p><p>{home.aboutDescription}</p><a class="text-link about-more" href={localizedPath('/about/', locale)}>{home.aboutMore} <span aria-hidden="true">↗</span></a><div class="about-facts">{home.facts.map(fact => <div><strong>{fact[0]}</strong><span>{fact[1]}</span></div>)}</div></div></div>
</section>
<FaqSection />
<ContactCTA />
