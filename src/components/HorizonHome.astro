---
import ConceptArt from './ConceptArt.astro';
import HorizonScenarios from './HorizonScenarios.astro';
import FaqSection from './FaqSection.astro';
import ContactCTA from './ContactCTA.astro';
import { siteConfig } from '../config';
import { servicePresentation, workingProcess } from '../data/site-content';
---
    <section class="concept-hero hero-horizon" aria-labelledby="hero-title">
      <ConceptArt kind="horizon" />
      <div class="hero-copy" data-parallax="-0.08">
        <p class="eyebrow"><span class="live-dot"></span>AI INTEGRATION / HUMAN POSSIBILITIES</p>
        <h1 id="hero-title">让智能，<br /><em>引力全开。</em></h1>
        <p class="hero-description">把前沿 AI，变成你的业务优势。<br />为中小企业与个人创业者，构建真正用得上的智能化方案。</p>
        <div class="hero-actions"><a class="primary-action" href="#capabilities" data-magnetic>探索我们的能力 <span>↗</span></a><a class="secondary-action" href="#contact">从一次交流开始 <span>→</span></a></div>
      </div>
      <div class="hero-bottom"><a href="#capabilities" class="scroll-cue"><span>↓</span> SCROLL TO DISCOVER</a><span class="hero-index">MOVE TO EXPLORE / 移动鼠标，探索引力场</span><span class="hero-location">ZHENGZHOU, CN<br />34° N / 113° E</span></div>
    </section>
    <div class="capability-strip"><span>小团队，也值得拥有强大的 AI。</span><div><span>AI INTEGRATION</span><i>✳</i><span>CONTENT CREATION</span><i>✳</i><span>TECH CONSULTING</span></div></div>
    <section class="capabilities section-space" id="capabilities" aria-labelledby="capabilities-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">01 / WHAT WE DO</p><h2 id="capabilities-title">从技术的可能，<br /><span>到业务的日常。</span></h2></div><p>不用追逐每一个新概念。<br />我们关心的是，AI 如何解决你的实际问题。</p></div>
      <div class="service-grid">{siteConfig.features.map((feature, i) => <article class={`service-panel service-${i}`} data-reveal data-spotlight>
        <div class="service-top"><span class="mono">0{i + 1} / {servicePresentation[i].english}</span><span class="service-symbol" aria-hidden="true">{['⌘', '✳', '↗'][i]}</span></div>
        <div class={`service-drawing drawing-${i}`} aria-hidden="true">{Array.from({length: i === 1 ? 9 : 5}, (_, n) => <span style={`--n:${n}`}></span>)}</div>
        <p class="service-category">{feature.title}</p><h3>{servicePresentation[i].title}</h3><p class="service-description">{feature.description}。{servicePresentation[i].description}</p>
        <details><summary>探索服务内容 <span>+</span></summary><ul>{feature.details.map(detail => <li>{detail}</li>)}</ul></details><a class="text-link" href={`/services/#${servicePresentation[i].id}`}>了解这项服务 <span aria-hidden="true">↗</span></a>
      </article>)}</div>
    </section>
    <HorizonScenarios />
    <section class="story-section" id="approach" aria-labelledby="approach-title">
      <div class="story-sticky"><p class="eyebrow">02 / HOW WE BUILD</p><h2 id="approach-title">从一个问题，<br />到一种新可能。</h2><p>不止于接入一个模型。<br />我们让技术顺着你的业务生长。</p><div class="story-orbits" data-parallax="0.06" aria-hidden="true"><span></span><span></span><span></span><b>AI</b></div></div>
      <div class="story-steps">{workingProcess.map(step => <article class="story-step" data-reveal><span class="step-number">{step.number}</span><p class="eyebrow">{step.english}</p><h3>{step.title}</h3><p>{step.description}</p><small>{step.scope}</small></article>)}</div>
    </section>
    <section class="about-section section-space" id="about" aria-labelledby="about-title">
      <p class="eyebrow" data-reveal>03 / THE PEOPLE BEHIND THE POSSIBILITY</p>
      <div class="about-composition"><h2 id="about-title" data-reveal>技术向前，<br />也让<span>你向前。</span></h2><div data-reveal><p class="about-lead">我们是灵映科技，<br />你的 AI 技术应用伙伴。</p><p>立足郑州，专注为中小企业和个人创业者提供 AI 集成与智能化解决方案。让技术降低门槛，让创意拥有工具，让有限的资源创造更多可能。</p><a class="text-link about-more" href="/about/">认识灵映科技 <span aria-hidden="true">↗</span></a><div class="about-facts"><div><strong>成本友好</strong><span>以实际需求选择方案</span></div><div><strong>简单易用</strong><span>让工具走进日常工作</span></div><div><strong>效果实用</strong><span>聚焦真实的业务痛点</span></div></div></div></div>
    </section>
    <FaqSection />
    <ContactCTA />
