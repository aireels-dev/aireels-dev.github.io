---
import { siteConfig } from '../config';
import Layout from '../layouts/Layout.astro';
import PageIntro from './PageIntro.astro';
import HorizonHome from './HorizonHome.astro';
import HorizonScenarios from './HorizonScenarios.astro';
import ContactCTA from './ContactCTA.astro';
import ContactChannels from './ContactChannels.astro';
import BrandMark from './BrandMark.astro';
import FaqSection from './FaqSection.astro';
import { getCopy } from '../i18n/copy';
import { localeFromPath, localizedPath, type Page } from '../i18n/routing';
interface Props { page: Page; languageEntry?: boolean; }
const { page, languageEntry = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const copy = getCopy(locale);
const meta = copy.meta[page];
const intro = page === 'services' ? copy.servicesPage : page === 'about' ? copy.aboutPage : copy.contactPage;
const about = copy.aboutPage;
const contact = copy.contactPage;
const emailFor = (subject: string) => `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`${contact.greeting}\n\n${contact.emailOpening} ${subject}.\n\n${contact.emailFields.map(field => `${field}:\n`).join('\n')}`)}`;
---
<Layout title={meta.title} description={meta.description} noindex={page === '404'} languageEntry={languageEntry}>
  {page === 'home' && <HorizonHome />}
  {['services', 'about', 'contact'].includes(page) && <PageIntro label={meta.title} eyebrow={intro.eyebrow} title={intro.title[0]} emphasis={intro.title[1]} description={intro.description}>
    {page === 'contact' ? <a class="contact-intro-mail" href={emailFor(contact.subject)}>{siteConfig.contactEmail} <span aria-hidden="true">↗</span></a> : <a class="secondary-action" href={page === 'services' ? '#service-details' : '#who-we-are'}>{page === 'services' ? copy.servicesPage.explore : about.explore} <span aria-hidden="true">↓</span></a>}
  </PageIntro>}

  {page === 'services' && <>
    <nav class="service-directory" aria-label={copy.ui.serviceDirectory}>{copy.services.map((service, i) => <a href={`#${service.id}`}><span class="mono">0{i + 1} / {service.english}</span><span>{service.category}</span><b aria-hidden="true">↘</b></a>)}</nav>
    <div id="service-details" class="service-details section-space">{copy.services.map((service, i) => <section class="service-detail" id={service.id} aria-labelledby={`title-${service.id}`}>
      <div class="service-detail-heading" data-reveal><p class="eyebrow">0{i + 1} / {service.english}</p><h2 id={`title-${service.id}`}>{service.title[0]}<br />{locale === 'en' ? ' ' : ''}<em>{service.title[1]}</em></h2><p>{service.description}</p><div class={`service-drawing drawing-${i}`} aria-hidden="true">{Array.from({ length: i === 1 ? 9 : 5 }, (_, n) => <span style={`--n:${n}`}></span>)}</div></div>
      <div class="service-detail-content" data-reveal><p class="service-detail-category">{service.category}</p><p class="service-detail-lead">{service.tagline}</p><div class="service-scope">{service.details.map((detail, index) => <article><span class="mono">0{index + 1}</span><div><h3>{detail.title}</h3><p>{detail.description}</p></div></article>)}</div><div class="service-fit"><span class="eyebrow">{copy.ui.fit}</span><p>{service.audience}</p></div><div class="service-outcomes" aria-label={copy.ui.outcomes}>{service.outcome.map(outcome => <span>{outcome}</span>)}</div><a class="text-link" href={localizedPath('/contact/', locale)}>{copy.ui.consult} <span aria-hidden="true">↗</span></a></div>
    </section>)}</div>
    <HorizonScenarios />
    <section class="process-section section-space" aria-labelledby="process-title"><div class="section-heading" data-reveal><div><p class="eyebrow">FROM FIRST TALK TO EVERYDAY USE</p><h2 id="process-title">{copy.servicesPage.processTitle[0]}<br /><span>{copy.servicesPage.processTitle[1]}</span></h2></div><p>{copy.servicesPage.processDescription[0]}<br />{copy.servicesPage.processDescription[1]}</p></div><div class="process-grid">{copy.process.map(step => <article data-reveal><span class="process-number">{step.number}</span><p class="eyebrow">{step.english}</p><h3>{step.title}</h3><p>{step.description}</p><small>{step.scope}</small></article>)}</div><p class="process-note">{copy.servicesPage.processNote}</p></section>
    <FaqSection /><ContactCTA />
  </>}

  {page === 'about' && <>
    <section class="company-section section-space" id="who-we-are" aria-labelledby="company-title"><div class="company-mark" aria-hidden="true"><div class="company-mark-orbit"></div><BrandMark /><span>AIREELS / HUMAN × INTELLIGENCE</span></div><div class="company-copy" data-reveal><p class="eyebrow">A SMALLER DISTANCE TO WHAT’S NEXT</p><h2 id="company-title">{about.companyTitle[0]}<br /><span>{about.companyTitle[1]}</span></h2><p class="company-lead" lang={locale === 'zh' ? 'zh-CN' : 'en'}>{copy.company.name}</p>{about.companyDescription.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href={localizedPath('/services/', locale)}>{about.more} <span aria-hidden="true">↗</span></a></div></section>
    <section class="principles-section section-space" aria-labelledby="principles-title"><div class="section-heading" data-reveal><div><p class="eyebrow">WHAT WE BELIEVE</p><h2 id="principles-title">{about.principlesTitle[0]}<br /><span>{about.principlesTitle[1]}</span></h2></div><p>{about.principlesDescription[0]}<br />{about.principlesDescription[1]}</p></div><div class="principles-list">{about.principles.map(principle => <article data-reveal><span class="principle-number">{principle.number}</span><div><p class="eyebrow">{principle.label}</p><h3>{principle.title}</h3></div><p>{principle.description}</p></article>)}</div></section>
    <section class="audience-section section-space" aria-labelledby="audience-title"><div class="section-heading" data-reveal><div><p class="eyebrow">BUILT FOR YOU</p><h2 id="audience-title">{about.audienceTitle[0]}<br /><span>{about.audienceTitle[1]}</span></h2></div><p>{about.audienceDescription[0]}<br />{about.audienceDescription[1]}</p></div><div class="audience-grid">{about.audiences.map((audience, i) => <article data-reveal data-spotlight><span class="mono">0{i + 1} / {audience[0]}</span><h3>{audience[1]}</h3><p>{audience[2]}</p></article>)}</div></section>
    <section class="location-section section-space" aria-labelledby="location-title"><div data-reveal><p class="eyebrow">{about.companyInfo}</p><h2 id="location-title">{about.infoTitle[0]}<br />{about.infoTitle[1]}</h2><dl class="company-information"><div><dt>{about.companyLabel}</dt><dd lang={locale === 'zh' ? 'zh-CN' : 'en'}>{copy.company.name}</dd></div><div><dt>{about.registeredOffice}</dt><dd>{copy.company.registeredOffice}</dd></div><div><dt>{about.hoursLabel}</dt><dd>{copy.company.hours}</dd></div></dl><a class="text-link" href={localizedPath('/contact/', locale)}>{copy.ui.contact} <span aria-hidden="true">↗</span></a></div><div class="location-art" aria-hidden="true"><span></span><span></span><span></span><i></i><b>AIREELS<small>{about.artSignature}</small></b></div></section>
    <ContactCTA />
  </>}

  {page === 'contact' && <>
    <section class="contact-options section-space" aria-labelledby="contact-options-title"><div data-reveal><p class="eyebrow">FIND THE RIGHT STARTING POINT</p><h2 id="contact-options-title">{contact.optionsTitle[0]}<br /><span>{contact.optionsTitle[1]}</span></h2><p>{contact.optionsDescription[0]}<br />{contact.optionsDescription[1]}</p><span class="contact-hint">{contact.hint}</span></div><div class="contact-service-links">{copy.services.map((service, i) => <a href={emailFor(service.category)} data-reveal><span class="mono">0{i + 1} / {service.english}</span><strong>{service.category}</strong><span aria-hidden="true">↗</span></a>)}</div></section>
    <section class="contact-information section-space" aria-labelledby="information-title">
      <p class="eyebrow">STAY CONNECTED</p>
      <h2 id="information-title">{contact.informationTitle}</h2>
      <div class="contact-information-grid">
        <article><span class="eyebrow">01 / EMAIL</span><h3>{contact.labels[0]}</h3><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail} ↗</a></article>
        <article><span class="eyebrow">02 / PHONE</span><h3>{contact.labels[1]}</h3><a href="tel:+8615330058983">+86 153 3005 8983 ↗</a></article>
        <article><span class="eyebrow">03 / REGISTERED OFFICE</span><h3>{contact.labels[2]}</h3><p>{copy.company.registeredOffice}<br />{copy.company.hours}</p></article>
      </div>
      <ContactChannels />
    </section>
    <section class="conversation-note section-space"><span class="eyebrow">BEFORE WE TALK</span><h2>{contact.noteTitle[0]}<br /><span>{contact.noteTitle[1]}</span></h2><p>{contact.note}</p><a class="primary-action" href={emailFor(contact.subject)}>{contact.emailAction} <span aria-hidden="true">↗</span></a></section>
  </>}

  {page === 'privacy' && <section class="legal-page section-space" aria-labelledby="privacy-title"><div class="legal-intro"><a class="breadcrumb" href={localizedPath('/', locale)}>{copy.ui.home} <span>/ {copy.ui.privacy}</span></a><h1 id="privacy-title">{copy.ui.privacy}</h1><p lang={locale === 'zh' ? 'zh-CN' : 'en'}>{copy.company.name}</p></div><div class="legal-content">{copy.privacy.sections.map(section => <><h2>{section.title}</h2><p>{section.description}</p>{section.items.length > 0 && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</>)}<h2>{copy.privacy.contactTitle}</h2><p>{copy.privacy.contactDescription}</p><ul><li>{contact.labels[0]}: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></li><li>{copy.privacy.addressLabel}: {copy.company.registeredOffice}</li></ul></div></section>}

  {page === '404' && <section class="not-found" aria-labelledby="not-found-title"><p class="eyebrow">LOST IN ORBIT / PAGE NOT FOUND</p><p class="not-found-code" aria-hidden="true">404</p><h1 id="not-found-title">{copy.notFound.title}</h1><p>{copy.notFound.description}</p><div class="hero-actions"><a class="primary-action" href={localizedPath('/', locale)}>{copy.notFound.home} <span aria-hidden="true">↗</span></a><a class="secondary-action" href={localizedPath('/contact/', locale)}>{copy.ui.contact} <span aria-hidden="true">→</span></a></div></section>}
</Layout>
