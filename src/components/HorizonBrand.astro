---
import { getCopy } from '../i18n/copy';
import { localeFromPath, localizedPath } from '../i18n/routing';
import BrandMark from './BrandMark.astro';
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const copy = getCopy(locale);
---
<a class:list={['horizon-brand', { 'horizon-brand-footer': footer }]} href={localizedPath('/', locale)} aria-label={`${copy.brand} ${copy.ui.home}`}>
  <BrandMark />
  <span class="horizon-brand-type">{copy.brand}<small>AI INTEGRATION STUDIO</small></span>
</a>
