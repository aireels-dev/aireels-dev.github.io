---
import { getCopy } from '../i18n/copy';
import { localeFromPath } from '../i18n/routing';
const copy = getCopy(localeFromPath(Astro.url.pathname)).scenarios;
const scenarios = copy.items;
---
<section class="horizon-scenarios section-space" aria-labelledby="scenarios-heading" data-scenarios>
  <div class="section-heading" data-reveal><div><p class="eyebrow">INTELLIGENCE / IN THE REAL WORLD</p><h2 id="scenarios-heading">{copy.title[0]}<br /><span>{copy.title[1]}</span></h2></div><p>{copy.description[0]}<br />{copy.description[1]}</p></div>
  <div class="scenario-tabs" role="tablist" aria-label={copy.label}>
    {scenarios.map((scenario, i) => <button type="button" role="tab" id={`tab-${scenario.id}`} aria-controls={`panel-${scenario.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span>0{i + 1}</span><b>{scenario.label}</b><span aria-hidden="true">↗</span></button>)}
  </div>
  {scenarios.map((scenario, i) => <div class="scenario-panel" role="tabpanel" id={`panel-${scenario.id}`} aria-labelledby={`tab-${scenario.id}`} hidden={i !== 0}>
    <div class="scenario-copy"><p class="eyebrow">{scenario.english}</p><h3>{scenario.title[0]}<br />{scenario.title[1]}</h3><p>{scenario.description}</p><a href="#contact" class="text-link">{copy.discuss} <span aria-hidden="true">↗</span></a></div>
    <div class="scenario-diagram" aria-label={`${scenario.label}: ${copy.diagram}`}>
      <div class="scenario-diagram-heading"><span>BUSINESS × INTELLIGENCE</span><span>{copy.example}</span></div>
      <div class="scenario-flow">
        <div class="scenario-input"><span class="scenario-node-label">{copy.input}</span>{scenario.input.map(input => <span class="scenario-input-item">{input}</span>)}</div><div class="scenario-connector" aria-hidden="true"></div>
        <div class="scenario-engine"><span class="scenario-engine-orbit" aria-hidden="true"></span><b>AI</b><span>{scenario.engine}</span></div><div class="scenario-connector" aria-hidden="true"></div>
        <div class="scenario-output"><span class="scenario-node-label">{copy.output}</span>{scenario.output.map(output => <span>{output}</span>)}</div>
      </div><p class="scenario-diagram-caption">{copy.caption}</p>
    </div>
  </div>)}
</section>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-scenarios]')) {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    function selectTab(selected: HTMLButtonElement) {
      for (const tab of tabs) {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) panel.hidden = panel.id !== selected.getAttribute('aria-controls');
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next]);
        tabs[next].focus();
      });
    });
  }
</script>
