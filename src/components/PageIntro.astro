---
import { getCopy } from '../i18n/copy';
import { localeFromPath, localizedPath } from '../i18n/routing';
const locale = localeFromPath(Astro.url.pathname);
const copy = getCopy(locale);
interface Props { eyebrow: string; title: string; emphasis: string; description: string; label: string; }
const { eyebrow, title, emphasis, description, label } = Astro.props;
---
<section class="page-intro" aria-labelledby="page-title">
  <div class="page-intro-art" aria-hidden="true"><span></span><span></span><span></span><i>✳</i></div>
  <a class="breadcrumb" href={localizedPath('/', locale)}>{copy.ui.home} <span>/ {label}</span></a>
  <div class="page-intro-content"><p class="eyebrow">{eyebrow}</p><h1 id="page-title">{title}<br /><em>{emphasis}</em></h1><p class="page-intro-description">{description}</p><slot /></div>
  <div class="page-intro-bottom"><span>AIREELS / AI INTEGRATION STUDIO</span><span>{copy.ui.pageSignature}</span></div>
</section>
