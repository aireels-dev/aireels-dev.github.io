---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config';
import '../styles/concepts.css';
import '../styles/horizon.css';
import '../styles/site.css';
interface Props { title?: string; description?: string; noindex?: boolean; canonicalPath?: string; }
const { title, description = siteConfig.description, noindex = false, canonicalPath = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : `${siteConfig.title} AIReels — 让智能，引力全开。`;
const canonical = new URL(canonicalPath, siteConfig.url).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="theme-color" content="#090b0e" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={siteConfig.logo} />
    <link rel="apple-touch-icon" href={siteConfig.logo} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', siteConfig.url).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/logo.png', siteConfig.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="concept-site horizon production-site" data-concept="horizon" id="top">
    <a href="#main" class="skip-link">跳转到主要内容</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>
      import { initConceptMotion } from '../scripts/concept-motion';
      initConceptMotion();
    </script>
  </body>
</html>
